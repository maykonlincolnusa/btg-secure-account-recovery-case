{
  "name": "secure-account-recovery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "docker:up": "docker compose -f infra/compose/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "turbo": "^2.0.11",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
